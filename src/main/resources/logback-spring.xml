<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_PATH" value="logs" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="CALCULATOR_INFO_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_PATH}/app-info.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="CALCULATOR_DEBUG_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_PATH}/app-debug.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="CALCULATOR_ERROR_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_PATH}/app-error.log</file>
        <append>false</append>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

    <logger name="org.springframework.web" level="INFO" additivity="false">
        <appender-ref ref="CALCULATOR_INFO_FILE" />
    </logger>

    <logger name="com.pat.crewhive" level="DEBUG" additivity="false">
        <appender-ref ref="CALCULATOR_DEBUG_FILE" />
        <appender-ref ref="CALCULATOR_ERROR_FILE" />
    </logger>

</configuration>
